# ─────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/veris_loyalty"

# ─────────────────────────────────────────────
# REDIS (para tokens QR efímeros)
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET="cambia_este_secreto_access_muy_seguro"
JWT_REFRESH_SECRET="cambia_este_secreto_refresh_muy_seguro"
JWT_QR_SECRET="cambia_este_secreto_qr_muy_seguro"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"
QR_TOKEN_TTL_SECONDS=30

# ─────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:8081"

# ─────────────────────────────────────────────
# SUPABASE (imágenes)
# ─────────────────────────────────────────────
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-supabase-anon-key"
SUPABASE_BUCKET="veris-imagenes"

# ─────────────────────────────────────────────
# PUNTOS POR COMPRA
# ─────────────────────────────────────────────
PUNTOS_POR_DOLAR=10
PUNTOS_PLATA=500
PUNTOS_ORO=2000
